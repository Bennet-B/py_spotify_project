{
  "openapi": "3.1.0",
  "info": {
    "title": "Spotify Project API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "description": "Liveness probe; carries no dependencies so it succeeds even before Spotify auth.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Me",
        "description": "Return the authenticated Spotify user's id and display name.",
        "operationId": "me_api_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/playlists": {
      "get": {
        "tags": [
          "playlists"
        ],
        "summary": "List Playlists",
        "description": "List the user's playlists with load/cache state, Liked Songs first.\n\n``track_count`` stays None for Liked Songs until a refresh job loads it \u2014 Spotify's saved-tracks endpoint offers no cheap count without fetching pages.",
        "operationId": "list_playlists_api_playlists_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaylistsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/playlists/{playlist_id}/refresh": {
      "post": {
        "tags": [
          "playlists"
        ],
        "summary": "Refresh Playlist",
        "description": "Start (or join) a background job that fetches the playlist and builds its dataset.\n\nCache-warm loads also run as jobs \u2014 they finish in seconds and keep the client's flow uniform. A queued or running job for the same playlist is joined,\nnot duplicated.",
        "operationId": "refresh_playlist_api_playlists__playlist_id__refresh_post",
        "parameters": [
          {
            "name": "playlist_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Playlist Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobAccepted"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/playlists/{playlist_id}/tracks": {
      "get": {
        "tags": [
          "playlists"
        ],
        "summary": "Playlist Tracks",
        "description": "Return the flattened track rows of a loaded playlist.\n\nRaises:\n    DatasetNotLoadedError: Mapped to HTTP 409 when no refresh job has loaded the playlist yet.",
        "operationId": "playlist_tracks_api_playlists__playlist_id__tracks_get",
        "parameters": [
          {
            "name": "playlist_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Playlist Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TracksResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Get Job",
        "description": "Return the current snapshot of a background job.\n\nRaises:\n    NotFoundError: Mapped to HTTP 404 when the job id is unknown or already evicted.",
        "operationId": "get_job_api_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "description": "Liveness probe body."
      },
      "JobAccepted": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          }
        },
        "type": "object",
        "required": [
          "job_id"
        ],
        "title": "JobAccepted",
        "description": "202 response carrying the id to poll at ``GET /api/jobs/{job_id}``."
      },
      "JobErrorOut": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "JobErrorOut",
        "description": "Error block of a failed job."
      },
      "JobOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "progress": {
            "$ref": "#/components/schemas/JobProgressOut"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobErrorOut"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "status",
          "progress",
          "result",
          "error"
        ],
        "title": "JobOut",
        "description": "Response of ``GET /api/jobs/{job_id}``."
      },
      "JobProgressOut": {
        "properties": {
          "phase": {
            "type": "string",
            "title": "Phase"
          },
          "done": {
            "type": "integer",
            "title": "Done"
          },
          "total": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "phase",
          "done",
          "total",
          "message"
        ],
        "title": "JobProgressOut",
        "description": "Progress block of a job snapshot."
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "done",
          "error"
        ],
        "title": "JobStatus",
        "description": "Lifecycle states of a background job."
      },
      "MeResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "display_name"
        ],
        "title": "MeResponse",
        "description": "The authenticated Spotify user."
      },
      "PlaylistItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "owner_name": {
            "type": "string",
            "title": "Owner Name"
          },
          "track_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Track Count"
          },
          "public": {
            "type": "boolean",
            "title": "Public"
          },
          "is_liked": {
            "type": "boolean",
            "title": "Is Liked"
          },
          "loaded": {
            "type": "boolean",
            "title": "Loaded"
          },
          "cached_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cached At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "owner_name",
          "track_count",
          "public",
          "is_liked",
          "loaded",
          "cached_at"
        ],
        "title": "PlaylistItem",
        "description": "One sidebar entry; id ``__liked__`` is the synthetic Liked Songs pseudo-playlist.\n\n``track_count`` is None when unknown (Liked Songs before its first load). ``cached_at`` is the raw-response cache write time, or None when uncached/stale."
      },
      "PlaylistsResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/PlaylistItem"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "PlaylistsResponse",
        "description": "Response of ``GET /api/playlists``."
      },
      "RefreshRequest": {
        "properties": {
          "force": {
            "type": "boolean",
            "title": "Force",
            "default": false
          }
        },
        "type": "object",
        "title": "RefreshRequest",
        "description": "Body of ``POST /api/playlists/{id}/refresh``; ``force`` bypasses the response cache."
      },
      "TrackRow": {
        "properties": {
          "track_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Track Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "primary_artist_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Primary Artist Id"
          },
          "primary_artist_name": {
            "type": "string",
            "title": "Primary Artist Name"
          },
          "artist_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Artist Ids"
          },
          "artist_names": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Artist Names"
          },
          "album_name": {
            "type": "string",
            "title": "Album Name"
          },
          "release_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Release Year"
          },
          "duration_ms": {
            "type": "integer",
            "title": "Duration Ms"
          },
          "explicit": {
            "type": "boolean",
            "title": "Explicit"
          },
          "added_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Added At"
          },
          "is_local": {
            "type": "boolean",
            "title": "Is Local"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags"
          },
          "genres": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Genres"
          }
        },
        "type": "object",
        "required": [
          "track_id",
          "name",
          "primary_artist_id",
          "primary_artist_name",
          "artist_ids",
          "artist_names",
          "album_name",
          "release_year",
          "duration_ms",
          "explicit",
          "added_at",
          "is_local",
          "tags",
          "genres"
        ],
        "title": "TrackRow",
        "description": "One flattened track, mirroring the columns of ``PlaylistAnalyzer.from_playlist``'s DataFrame."
      },
      "TracksResponse": {
        "properties": {
          "playlist_id": {
            "type": "string",
            "title": "Playlist Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "tracks": {
            "items": {
              "$ref": "#/components/schemas/TrackRow"
            },
            "type": "array",
            "title": "Tracks"
          }
        },
        "type": "object",
        "required": [
          "playlist_id",
          "name",
          "tracks"
        ],
        "title": "TracksResponse",
        "description": "Response of ``GET /api/playlists/{id}/tracks``."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}