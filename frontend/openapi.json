{
  "openapi": "3.1.0",
  "info": {
    "title": "Spotify Project API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "description": "Liveness probe; carries no dependencies so it succeeds even before Spotify auth.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Me",
        "description": "Return the authenticated Spotify user's id and display name.",
        "operationId": "me_api_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/playlists": {
      "get": {
        "tags": [
          "playlists"
        ],
        "summary": "List Playlists",
        "description": "List the user's playlists with load/cache state, Liked Songs first.\n\n``track_count`` stays None for Liked Songs until a refresh job loads it \u2014 Spotify's saved-tracks endpoint offers no cheap count without fetching pages.",
        "operationId": "list_playlists_api_playlists_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaylistsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/playlists/{playlist_id}/refresh": {
      "post": {
        "tags": [
          "playlists"
        ],
        "summary": "Refresh Playlist",
        "description": "Start (or join) a background job that fetches the playlist and builds its dataset.\n\nCache-warm loads also run as jobs \u2014 they finish in seconds and keep the client's flow uniform. A queued or running job for the same playlist is joined,\nnot duplicated.",
        "operationId": "refresh_playlist_api_playlists__playlist_id__refresh_post",
        "parameters": [
          {
            "name": "playlist_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Playlist Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobAccepted"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/playlists/{playlist_id}/tracks": {
      "get": {
        "tags": [
          "playlists"
        ],
        "summary": "Playlist Tracks",
        "description": "Return the flattened track rows of a loaded playlist.\n\nRaises:\n    DatasetNotLoadedError: Mapped to HTTP 409 when no refresh job has loaded the playlist yet.",
        "operationId": "playlist_tracks_api_playlists__playlist_id__tracks_get",
        "parameters": [
          {
            "name": "playlist_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Playlist Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TracksResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/playlists/{playlist_id}/insights/labels": {
      "get": {
        "tags": [
          "insights"
        ],
        "summary": "Labels",
        "description": "Tag/genre frequency bars \u2014 the primary rule-helper chart (bar click \u2192 tag filter).",
        "operationId": "labels_api_playlists__playlist_id__insights_labels_get",
        "parameters": [
          {
            "name": "playlist_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Playlist Id"
            }
          },
          {
            "name": "field",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "genres",
                "tags"
              ],
              "type": "string",
              "default": "genres",
              "title": "Field"
            }
          },
          {
            "name": "top_n",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 30,
              "title": "Top N"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LabelsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/playlists/{playlist_id}/insights/years": {
      "get": {
        "tags": [
          "insights"
        ],
        "summary": "Years",
        "description": "Tracks per release year, pre-binned server-side so a bar click/box-select maps to exact years.",
        "operationId": "years_api_playlists__playlist_id__insights_years_get",
        "parameters": [
          {
            "name": "playlist_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Playlist Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/YearsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/playlists/{playlist_id}/insights/additions": {
      "get": {
        "tags": [
          "insights"
        ],
        "summary": "Additions",
        "description": "Library growth: additions per period plus cumulative tracks/hours.",
        "operationId": "additions_api_playlists__playlist_id__insights_additions_get",
        "parameters": [
          {
            "name": "playlist_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Playlist Id"
            }
          },
          {
            "name": "freq",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "W",
                "M",
                "Q",
                "Y"
              ],
              "type": "string",
              "default": "M",
              "title": "Freq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdditionsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/playlists/{playlist_id}/insights/discovery": {
      "get": {
        "tags": [
          "insights"
        ],
        "summary": "Discovery",
        "description": "Artist discovery waves: how many artists enter the library for the first time per period.",
        "operationId": "discovery_api_playlists__playlist_id__insights_discovery_get",
        "parameters": [
          {
            "name": "playlist_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Playlist Id"
            }
          },
          {
            "name": "freq",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "W",
                "M",
                "Q",
                "Y"
              ],
              "type": "string",
              "default": "M",
              "title": "Freq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoveryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/playlists/{playlist_id}/insights/seasonal": {
      "get": {
        "tags": [
          "insights"
        ],
        "summary": "Seasonal",
        "description": "Additions by calendar month aggregated across years (always 12 rows).",
        "operationId": "seasonal_api_playlists__playlist_id__insights_seasonal_get",
        "parameters": [
          {
            "name": "playlist_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Playlist Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeasonalResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/playlists/{playlist_id}/insights/artists": {
      "get": {
        "tags": [
          "insights"
        ],
        "summary": "Artists",
        "description": "Track counts per credited artist; repeatable ``genre`` params implement the cascading genre\u2192artist re-scope.",
        "operationId": "artists_api_playlists__playlist_id__insights_artists_get",
        "parameters": [
          {
            "name": "playlist_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Playlist Id"
            }
          },
          {
            "name": "genre",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Genre"
            }
          },
          {
            "name": "top_n",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 25,
              "title": "Top N"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtistsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/playlists/{playlist_id}/insights/release-vs-added": {
      "get": {
        "tags": [
          "insights"
        ],
        "summary": "Release Vs Added",
        "description": "Release-year vs added-year scatter rows; carries track ids so a lasso selection can become a playlist.",
        "operationId": "release_vs_added_api_playlists__playlist_id__insights_release_vs_added_get",
        "parameters": [
          {
            "name": "playlist_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Playlist Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReleaseVsAddedResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Get Job",
        "description": "Return the current snapshot of a background job.\n\nRaises:\n    NotFoundError: Mapped to HTTP 404 when the job id is unknown or already evicted.",
        "operationId": "get_job_api_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdditionRow": {
        "properties": {
          "period": {
            "type": "string",
            "format": "date-time",
            "title": "Period"
          },
          "added": {
            "type": "integer",
            "title": "Added"
          },
          "cumulative_tracks": {
            "type": "integer",
            "title": "Cumulative Tracks"
          },
          "cumulative_hours": {
            "type": "number",
            "title": "Cumulative Hours"
          }
        },
        "type": "object",
        "required": [
          "period",
          "added",
          "cumulative_tracks",
          "cumulative_hours"
        ],
        "title": "AdditionRow",
        "description": "One period of the library-growth chart."
      },
      "AdditionsResponse": {
        "properties": {
          "freq": {
            "type": "string",
            "title": "Freq"
          },
          "rows": {
            "items": {
              "$ref": "#/components/schemas/AdditionRow"
            },
            "type": "array",
            "title": "Rows"
          }
        },
        "type": "object",
        "required": [
          "freq",
          "rows"
        ],
        "title": "AdditionsResponse",
        "description": "Response of ``GET .../insights/additions``."
      },
      "ArtistCountRow": {
        "properties": {
          "artist_id": {
            "type": "string",
            "title": "Artist Id"
          },
          "artist_name": {
            "type": "string",
            "title": "Artist Name"
          },
          "track_count": {
            "type": "integer",
            "title": "Track Count"
          }
        },
        "type": "object",
        "required": [
          "artist_id",
          "artist_name",
          "track_count"
        ],
        "title": "ArtistCountRow",
        "description": "One bar of the (optionally genre-scoped) artist chart."
      },
      "ArtistsResponse": {
        "properties": {
          "scoped_to_genres": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Scoped To Genres"
          },
          "rows": {
            "items": {
              "$ref": "#/components/schemas/ArtistCountRow"
            },
            "type": "array",
            "title": "Rows"
          }
        },
        "type": "object",
        "required": [
          "scoped_to_genres",
          "rows"
        ],
        "title": "ArtistsResponse",
        "description": "Response of ``GET .../insights/artists``; ``scoped_to_genres`` echoes the cascading genre filter."
      },
      "DiscoveryResponse": {
        "properties": {
          "freq": {
            "type": "string",
            "title": "Freq"
          },
          "rows": {
            "items": {
              "$ref": "#/components/schemas/DiscoveryRow"
            },
            "type": "array",
            "title": "Rows"
          }
        },
        "type": "object",
        "required": [
          "freq",
          "rows"
        ],
        "title": "DiscoveryResponse",
        "description": "Response of ``GET .../insights/discovery``."
      },
      "DiscoveryRow": {
        "properties": {
          "period": {
            "type": "string",
            "format": "date-time",
            "title": "Period"
          },
          "new_artists": {
            "type": "integer",
            "title": "New Artists"
          }
        },
        "type": "object",
        "required": [
          "period",
          "new_artists"
        ],
        "title": "DiscoveryRow",
        "description": "One period of the artist-discovery-waves chart."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "description": "Liveness probe body."
      },
      "JobAccepted": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          }
        },
        "type": "object",
        "required": [
          "job_id"
        ],
        "title": "JobAccepted",
        "description": "202 response carrying the id to poll at ``GET /api/jobs/{job_id}``."
      },
      "JobErrorOut": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "JobErrorOut",
        "description": "Error block of a failed job."
      },
      "JobOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "progress": {
            "$ref": "#/components/schemas/JobProgressOut"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobErrorOut"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "status",
          "progress",
          "result",
          "error"
        ],
        "title": "JobOut",
        "description": "Response of ``GET /api/jobs/{job_id}``."
      },
      "JobProgressOut": {
        "properties": {
          "phase": {
            "type": "string",
            "title": "Phase"
          },
          "done": {
            "type": "integer",
            "title": "Done"
          },
          "total": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "phase",
          "done",
          "total",
          "message"
        ],
        "title": "JobProgressOut",
        "description": "Progress block of a job snapshot."
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "done",
          "error"
        ],
        "title": "JobStatus",
        "description": "Lifecycle states of a background job."
      },
      "LabelCountRow": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "label",
          "count"
        ],
        "title": "LabelCountRow",
        "description": "One bar of the tag/genre frequency chart."
      },
      "LabelsResponse": {
        "properties": {
          "field": {
            "type": "string",
            "enum": [
              "genres",
              "tags"
            ],
            "title": "Field"
          },
          "rows": {
            "items": {
              "$ref": "#/components/schemas/LabelCountRow"
            },
            "type": "array",
            "title": "Rows"
          }
        },
        "type": "object",
        "required": [
          "field",
          "rows"
        ],
        "title": "LabelsResponse",
        "description": "Response of ``GET .../insights/labels``; ``field`` echoes which label column was counted."
      },
      "MeResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "display_name"
        ],
        "title": "MeResponse",
        "description": "The authenticated Spotify user."
      },
      "PlaylistItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "owner_name": {
            "type": "string",
            "title": "Owner Name"
          },
          "track_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Track Count"
          },
          "public": {
            "type": "boolean",
            "title": "Public"
          },
          "is_liked": {
            "type": "boolean",
            "title": "Is Liked"
          },
          "loaded": {
            "type": "boolean",
            "title": "Loaded"
          },
          "cached_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cached At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "owner_name",
