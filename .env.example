# Copy this file to .env and fill in the values from your Spotify Developer App.
# .env is gitignored. NEVER commit your real client_secret!

# Register an app at: https://developer.spotify.com/dashboard
# In the app's settings, add http://127.0.0.1:8888/callback as a Redirect URI.
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional — enables Last.fm artist tag enrichment.
# Without this, the notebook still runs but skips genre/tag analysis,
# since Spotify's /artists endpoint no longer returns the `genres` field for apps registered after 2024-11-27.
# Register at: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Optional — log levels the notebook passes to configure_logging().
# APP_LOG_LEVEL governs spotify_project.* loggers; THIRD_PARTY_LOG_LEVEL governs everything else (spotipy, urllib3, ...).
#APP_LOG_LEVEL=INFO
#THIRD_PARTY_LOG_LEVEL=WARNING
