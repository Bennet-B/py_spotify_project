# Copy this file to .env and fill in the values from your Spotify Developer App.
# .env is gitignored. NEVER commit your real client_secret.
#
# Register an app at: https://developer.spotify.com/dashboard
# In the app's settings, add http://127.0.0.1:8888/callback as a Redirect URI.

SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
